{
  "schema_version": 1,
  "milestone": "M2",
  "run_family": "5x5-solved-play-reproduction",
  "board": {
    "size": 5,
    "walls_per_player": 3,
    "max_plies": 200
  },
  "observation": {
    "version": 1,
    "encoding": "six-plane-mover-canonical"
  },
  "action_space": {
    "encoding": "flat-mover-canonical",
    "pawn_actions": 12,
    "wall_grid_size": 4,
    "action_count": 44,
    "policy_head": "flat-board-size-dependent",
    "size_agnostic_policy_head": false
  },
  "network": {
    "trunk": "resnet-global-pooling",
    "blocks": 8,
    "filters": 96,
    "global_pool_blocks": [2, 5],
    "policy_head": "flat",
    "value_head": "tanh-scalar",
    "auxiliary_targets": ["own_shortest_path", "opponent_shortest_path"],
    "auxiliary_loss_weight": 0.1,
    "opponent_policy_head_loss_weight": 0.15,
    "ema_decay": 0.999,
    "batch_norm_epsilon": 0.00001,
    "batch_norm_momentum": 0.1,
    "medium_variant": {
      "blocks": 12,
      "filters": 128,
      "use_only_after_small_model_capacity_plateau": true
    }
  },
  "mcts": {
    "mode": "puct",
    "self_play_simulations": 200,
    "evaluation_simulations": 800,
    "cpuct_init": 1.6,
    "fpu_reduction": 0.2,
    "root_dirichlet_alpha": 0.6,
    "root_noise_fraction": 0.25,
    "forced_playouts": true,
    "forced_playout_weight": 2.0,
    "policy_target_pruning": true,
    "temperature_moves": 16,
    "gumbel_candidates": 16
  },
  "self_play": {
    "gamma": 1.0,
    "reward": "terminal-win-loss-cap-zero",
    "resignation": false,
    "full_search_probability": 0.25,
    "fast_search_fraction": 0.25,
    "cap_adjudication": {
      "fraction_threshold": 0.05,
      "consecutive_cycles": 3,
      "scoring_scheme": "terminal-win-loss-cap-shortest-path-adjudicated"
    },
    "weak_start_state_diversification": {
      "enabled": true,
      "raw_policy_injection_probability": 0.04,
      "diversification_plies": 8,
      "exclude_pre_injection_value_targets": true
    }
  },
  "training": {
    "optimizer": "sgd",
    "momentum": 0.9,
    "initial_learning_rate": 0.02,
    "learning_rate_drops": [0.002, 0.0002],
    "learning_rate_drop_steps": [100000, 200000],
    "planned_steps": 300000,
    "batch_size": 512,
    "weight_decay": 0.0001,
    "mirror_augmentation": true
  },
  "replay": {
    "positions": 300000,
    "target_samples_per_position_min": 1,
    "target_samples_per_position_max": 4
  },
  "gating": {
    "enabled": true,
    "games": 200,
    "promotion_threshold": 0.55
  },
  "acceptance": {
    "known_initial_result": "second-player-win",
    "solver_labelled_positions": 5000,
    "value_sign_accuracy_min": 0.99,
    "mcts_optimal_move_accuracy_min": 0.99,
    "second_player_win_rate_min": 1.0,
    "require_monotone_ladder_elo": true
  }
}
